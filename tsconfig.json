{
  "compilerOptions": {
    "target": "ESNext",
    "module": "commonjs",
    "moduleResolution": "bundler" /* TS 7 removed node10, the old default for commonjs. */,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "types": ["vitest/globals", "node"],
    "paths": {
      "src/*": ["./src/*"]
    }
  }
}
