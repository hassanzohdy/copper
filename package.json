{
  "name": "@mongez/copper",
  "version": "2.1.4",
  "description": "Zero-dependency CLI toolkit: ANSI colors with a 20+ palette, spinners, progress bars, boxed messages, themed loggers, OSC-8 hyperlinks, and ANSI stripping. NO_COLOR friendly.",
  "main": "src/index.ts",
  "sideEffects": false,
  "author": "hassanzohdy",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hassanzohdy/copper"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "keywords": [
    "ansi",
    "colors",
    "cli",
    "terminal",
    "console",
    "chalk",
    "picocolors",
    "spinner",
    "progress-bar",
    "logger",
    "box",
    "no-color",
    "force-color",
    "osc-8",
    "hyperlink",
    "strip-ansi",
    "256-color",
    "typescript",
    "zero-dependency"
  ],
  "packageManager": "pnpm@12.15.0"
